# Copie para .env (que não é versionado) e preencha só o que for usar:
#   cp .env.example .env && chmod 600 .env
# Variáveis já definidas no terminal têm prioridade sobre este arquivo.

# Provedores de modelos (modo API). Basta um.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Biblioteca de prompts (mcp-prompts). Use uma chave de LEITURA restrita ao grupo;
# escrita só se for salvar resultados na biblioteca.
MCP_PROMPTS_URL=https://code.danielcarlos.dev/mcp
MCP_PROMPTS_TOKEN=

# Ações ao terminar (opcionais)
AZURE_DEVOPS_PAT=
GITHUB_TOKEN=

# Teto padrão por execução em US$ (opcional)
# ORCHESTRATOR_TETO_USD=0.50
